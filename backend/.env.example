APP_ENV=development
APP_NAME=NusaChat
; Absolute upload URLs use APP_URL when it points to a real host. With
; localhost/127.0.0.1 the API falls back to the current request host, which
; keeps uploads reachable from a phone on the LAN. Set the public HTTPS URL
; in production.
APP_URL=http://localhost:8080
; Change this in production. Used to sign access tokens (HS256).
APP_SECRET=dev-secret-change-me-please-32-bytes-min

; Access token: 7 days. Refresh token: 30 days.
JWT_TTL=604800
REFRESH_TTL=2592000

; sqlite (default, zero setup) or mysql
DB_DRIVER=sqlite
DB_PATH=storage/nusachat.sqlite

; Used only when DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nusachat
DB_USER=root
DB_PASS=

UPLOAD_MAX_MB=25
CORS_ORIGINS=*

; Public websocket URL returned by GET /api/v1/config. The Android client
; currently uses WS_URL from build.gradle.kts, but other clients may read this.
WS_PUBLIC_URL=ws://localhost:8090
WS_BIND=tcp://0.0.0.0:8090
; Shared secret for future server-to-server calls (optional)
WS_SECRET=dev-ws-secret

; Max accounts created from one IP per hour (0 = disabled)
REGISTER_RATE_LIMIT=20

; Firebase Cloud Messaging. Primary: HTTP v1 via service account
; (Project settings > Service accounts > Generate new private key).
; Point FCM_SERVICE_JSON at the downloaded JSON (relative to backend/).
FCM_SERVICE_JSON=storage/fcm-service-account.json
FCM_PROJECT_ID=dachat-6fd87
; Fallback: legacy HTTP API key (Project settings > Cloud Messaging).
; Empty = push disabled; the API keeps working and realtime WS is used
; when the app is open.
FCM_SERVER_KEY=
