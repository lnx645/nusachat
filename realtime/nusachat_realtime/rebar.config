{erl_opts, [debug_info]}.
%% no_unknown: abaikan "Unknown type" dari spec library (cowboy/ranch);
%% kode kita sendiri tetap dicek penuh.
{dialyzer, [{warnings, [no_unknown]}]}.
{deps, [
    {cowboy, "2.12.0"},
    {mysql, "1.8.0"},
    {jsx, "3.1.0"}
]}.

{shell, [
    {apps, [nusachat_realtime]}
]}.

{relx, [
    {release, {nusachat_realtime, "0.1.0"}, [nusachat_realtime, cowboy, mysql, jsx, sasl]},
    {dev_mode, true},
    {include_erts, false},
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"}
]}.
